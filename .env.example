# BrickDeal — environment template. Copy to .env and fill in; .env is never
# committed (see .gitignore). server/env.js reads .env at startup, and the real
# process environment always wins over a value in the file.
#
# The TikTok values come from the app's page on developers.tiktok.com
# (Login Kit + Content Posting API, scopes user.info.basic and video.upload).

# App credentials. The secret is server-side only — it must never reach a
# browser, a log line, or this repo.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Must match the redirect URI registered on the app, character for character.
# https://www.brickdealil.com/tiktok/callback
TIKTOK_REDIRECT_URI=

# Comma-separated list of domains verified on the app. Empty while the app is in
# Sandbox: with no verified domain, PULL_FROM_URL uploads are not available and
# only the FILE_UPLOAD path in server/tiktok-client.js can be used.
TIKTOK_VERIFIED_DOMAINS=

# Optional. Defaults: 127.0.0.1, 8791, ./data/tiktok-tokens.json
# TIKTOK_HOST=
# TIKTOK_PORT=
# TIKTOK_TOKEN_STORE=
